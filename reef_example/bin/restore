#!/bin/bash
# `restore` as pi sees it inside a reef episode.
#
# reef strips the episode environment down to PATH/TMPDIR (+ pi's own vars), so the
# toolbox's RESTORE_* knobs cannot be injected from serve.yaml. This wrapper sits first
# on PATH and pins them: results/cache/trace land in reef_example/work/ (outside the
# throwaway episode root, which reef deletes), and RESTORE_EPISODE_ID is derived from
# the episode root's name (cwd is <root>/workspace, root = reef-episode-pi-XXXX), so
# every episode's verdict.json / output.png / trace lines are keyed without the agent
# having to pass anything.
set -e
HERE="$(cd "$(dirname "$0")/.." && pwd)"
export RESTORE_RESULTS_DIR="${RESTORE_RESULTS_DIR:-$HERE/work/results}"
export RESTORE_CACHE_DIR="${RESTORE_CACHE_DIR:-$HERE/work/cache}"
export RESTORE_TRACE="${RESTORE_TRACE:-$RESTORE_RESULTS_DIR/trace.jsonl}"
if [ -z "$RESTORE_EPISODE_ID" ]; then
    # The id must be identical for every call inside one episode - it is the key
    # the judge joins `result` to the trace on. Deriving it from the *parent* of
    # cwd broke as soon as the agent cd'd anywhere: the fallback then fired, and
    # because it was `adhoc-$(date +%s)-$$`, every single invocation got a
    # different id. The trace scattered, the judge found no successful run under
    # the one id it saw, and scored a working episode 0.0. Every 0.0 seen on
    # 2026-09-03 is explainable by this.
    #
    # So: look for the reef-episode-<id> component anywhere in cwd, then in the
    # episode paths pi itself is given (independent of cwd), and only then fall
    # back - to a value derived from cwd, so repeated calls still share one id.
    for candidate in "$PWD" "$PI_CODING_AGENT_DIR" "$PI_CODING_AGENT_SESSION_DIR"; do
        [ -n "$candidate" ] || continue
        case "$candidate" in
            *reef-episode-*)
                trimmed="${candidate#*reef-episode-}"
                RESTORE_EPISODE_ID="${trimmed%%/*}"
                break
                ;;
        esac
    done
    if [ -z "$RESTORE_EPISODE_ID" ]; then
        RESTORE_EPISODE_ID="adhoc-$(printf '%s' "$PWD" | shasum | cut -c1-8)"
    fi
    export RESTORE_EPISODE_ID
fi
# Announce the id on every call, on stdout, so it is guaranteed to be in the
# trajectory the judge sees. The judge links `result` to its trace lines through
# this string; it used to dig the episode root out of whatever tool output
# happened to mention an absolute path, and an agent that stuck to relative
# paths left it with nothing - `evaluate: no restore run output found
# (episode=None)` scored a possibly-fine episode 0.0, indistinguishable from a
# restoration that achieved nothing (2026-09-03).
echo "reef-episode-$RESTORE_EPISODE_ID"
exec "$HERE/../.venv/bin/restore" "$@"
